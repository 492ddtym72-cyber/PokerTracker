{
  "name": "pokertracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && npm run typecheck:functions && vite build",
    "preview": "vite preview",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json",
    "pages:dev": "npm run build && wrangler pages dev dist"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.34.0"
  }
}
